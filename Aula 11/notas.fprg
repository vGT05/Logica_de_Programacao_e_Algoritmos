<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="notas"/>
        <attribute name="authors" value="FIC"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-03-09 07:29:52 "/>
        <attribute name="created" value="RklDO0VDRlA1MTIxMzE5MzY5OzIwMjYtMDMtMDk7IjA3OjE3OjQ4ICI7MjIyMA=="/>
        <attribute name="edited" value="RklDO0VDRlA1MTIxMzE5MzY5OzIwMjYtMDMtMDk7IjA3OjI5OjUyICI7MTsyMzI2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nota1, nota2, notafinal" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a primeira nota: &quot;" newline="True"/>
            <input variable="nota1"/>
            <output expression="&quot;Digite a segunda nota: &quot;" newline="True"/>
            <input variable="nota2"/>
            <assign variable="notafinal" expression="nota1+nota2"/>
            <if expression="notafinal&gt;60">
                <then>
                    <output expression="&quot;aprovado! nota fical: &quot; &amp;notafinal" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;reprovado! nota final: &quot; &amp;notafinal" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
